<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.back.mypage.profile.mapper.ProfileMapper">

    <select id="findMemberInfoByUserId" resultType="com.back.mypage.profile.dto.ProfileResponse">
        SELECT member_type AS memberType,
               admin_level AS adminLevel
        FROM users
        WHERE user_id = #{userId}
          AND is_deleted = false
        LIMIT 1
    </select>

</mapper>