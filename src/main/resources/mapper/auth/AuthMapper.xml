<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.back.auth.mapper.AuthMapper">
    <!-- loginId 찾기 -->
    <select id="findByLoginId" resultType="com.back.auth.dto.UserDto">
        SELECT user_id       AS userId,
               login_id      AS loginId,
               password_hash AS passwordHash,
               name,
               email,
               role,
               is_deleted    AS isDeleted,
               ban_status    AS banStatus,
               banned_until  AS bannedUntil
        FROM users
        WHERE login_id = #{loginId}
    </select>

    <!-- 로그인 로그 기록 -->
    <update id="updateLastLoginAt">
        UPDATE users SET last_login_at = NOW()
        WHERE login_id = #{loginId}
    </update>


<!--    void insertLoginLogWithSession(@Param("userId") Long userId, String role, String sessionKey);-->


    <!-- 회원가입 -->
    <insert id="insertUser" useGeneratedKeys="true" keyProperty="userId">
        INSERT INTO users (name, phone, major, student_no, email, login_id, password_hash, role, is_deleted)
        VALUES (#{name},#{phone}, #{major}, #{studentNo}, #{email}, #{loginId}, #{passwordHash}, #{role}, #{isDeleted})
    </insert>

    <!-- 회원가입 - 아이디 & 이메일 중복 확인 -->
    <select id="existsByLoginId" resultType="boolean">
        SELECT COUNT(*) > 0 FROM users WHERE login_id = #{loginId}
    </select>
    <select id="existsByEmail" resultType="boolean">
        SELECT COUNT(*) > 0 FROM users WHERE email = #{email}
    </select>

    <!-- 아이디 찾기 - 이메일로 login_id 조회 -->
    <select id="findLoginIdByEmail" resultType="string">
        SELECT login_id
        FROM users
        WHERE email = #{email}
            LIMIT 1
    </select>

    <!-- 비밀번호 초기화 전 단계 - 아이디/이메일 일치 확인 -->
    <select id="existsByLoginIdAndEmail" resultType="boolean">
        SELECT COUNT(*) > 0
        FROM users
        WHERE login_id = #{loginId}
          AND email = #{email}
    </select>

    <!-- 비밀번호 초기화 -->
    <update id="updatePassword">
        UPDATE users SET password_hash = #{password}
        WHERE login_id = #{loginId}
    </update>
</mapper>

